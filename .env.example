# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Dify API（Cloud: https://api.dify.ai/v1 / セルフホストはベースURLを変更）
DIFY_API_KEY=
DIFY_API_URL=https://api.dify.ai/v1

# 任意: Dify の user 識別子プレフィックス（LINE userId の前に付与）
DIFY_USER_PREFIX=line-

# Dify チャットフロー必須 inputs（target_agent）
DIFY_TARGET_AGENT=ソル（Cursor）
